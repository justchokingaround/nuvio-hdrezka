# Pick one tunnel provider: cloudflare or ngrok
TUNNEL_PROVIDER=ngrok

# --- ngrok (easiest free persistent URL) ---
# 1. Sign up at https://dashboard.ngrok.com/signup
# 2. Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
#    and run:  ngrok config add-authtoken <token>
# 3. Claim your free static domain in https://dashboard.ngrok.com/domains
#    (it looks like xxxxxx.ngrok-free.app)
NGROK_DOMAIN=xxxxxx.ngrok-free.app

# --- Cloudflare Tunnel (unmetered, but requires your own domain) ---
# The domain must already be on a Cloudflare account you control.
# CLOUDFLARE_TUNNEL_HOSTNAME=hdrezka.example.com
